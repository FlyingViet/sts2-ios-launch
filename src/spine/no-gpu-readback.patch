+		static int layout_check = 0; // 0 unchecked, 1 computed layout verified, -1 mismatch: always read back
+		const int64_t computed_format = RS::ARRAY_FORMAT_VERTEX | RS::ARRAY_FORMAT_TEX_UV | RS::ARRAY_FORMAT_COLOR | RS::ARRAY_FORMAT_INDEX | RS::ARRAY_FLAG_USE_2D_VERTICES | RS::ARRAY_FLAG_USE_DYNAMIC_UPDATE;
+		const int64_t layout_mask = RS::ARRAY_FORMAT_VERTEX | RS::ARRAY_FORMAT_NORMAL | RS::ARRAY_FORMAT_TANGENT | RS::ARRAY_FORMAT_COLOR | RS::ARRAY_FORMAT_TEX_UV | RS::ARRAY_FORMAT_TEX_UV2 | RS::ARRAY_FORMAT_CUSTOM0 | RS::ARRAY_FORMAT_CUSTOM1 | RS::ARRAY_FORMAT_CUSTOM2 | RS::ARRAY_FORMAT_CUSTOM3 | RS::ARRAY_FORMAT_BONES | RS::ARRAY_FORMAT_WEIGHTS | RS::ARRAY_FORMAT_INDEX | RS::ARRAY_FLAG_USE_2D_VERTICES | RS::ARRAY_FLAG_USE_DYNAMIC_UPDATE | RS::ARRAY_FLAG_COMPRESS_ATTRIBUTES;
+		Dictionary surface;
+		int64_t format_bits = computed_format;
+		if (layout_check != 1) {
+			surface = RS::get_singleton()->mesh_get_surface(mesh, 0);
+			format_bits = static_cast<int64_t>(surface["format"]);
+		}
+		RS::ArrayFormat surface_format = (RS::ArrayFormat) format_bits;
 		surface_offsets[RS::ARRAY_VERTEX] = RS::get_singleton()->mesh_surface_get_format_offset(surface_format, vertices.size(), RS::ARRAY_VERTEX);
 		surface_offsets[RS::ARRAY_COLOR] = RS::get_singleton()->mesh_surface_get_format_offset(surface_format, vertices.size(), RS::ARRAY_COLOR);
 		surface_offsets[RS::ARRAY_TEX_UV] = RS::get_singleton()->mesh_surface_get_format_offset(surface_format, vertices.size(), RS::ARRAY_TEX_UV);
 		vertex_stride = RS::get_singleton()->mesh_surface_get_format_vertex_stride(surface_format, vertices.size());
 		attribute_stride = RS::get_singleton()->mesh_surface_get_format_attribute_stride(surface_format, vertices.size());
-		vertex_buffer = surface["vertex_data"];
-		attribute_buffer = surface["attribute_data"];
+		if (layout_check == 1) {
+			vertex_buffer.resize(int64_t(vertex_stride) * vertices.size());
+			attribute_buffer.resize(int64_t(attribute_stride) * vertices.size());
+		} else {
+			vertex_buffer = surface["vertex_data"];
+			attribute_buffer = surface["attribute_data"];
+			if (layout_check == 0) {
+				bool same = (format_bits & layout_mask) == computed_format &&
+							vertex_buffer.size() == int64_t(vertex_stride) * vertices.size() &&
+							attribute_buffer.size() == int64_t(attribute_stride) * vertices.size();
+				layout_check = same ? 1 : -1;
+				UtilityFunctions::print(same ? "[PORT] spine: mesh layout computed on the CPU (no GPU readback)"
