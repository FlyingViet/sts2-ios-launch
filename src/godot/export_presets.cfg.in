[preset.0]

name="iOS"
platform="iOS"
runnable=true
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="@EXPORT_PATH@"
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

custom_template/debug=""
custom_template/release="@TEMPLATE@"
architectures/arm64=true
application/app_store_team_id="@TEAM@"
application/export_method_debug=1
application/export_method_release=1
application/bundle_identifier="@BUNDLE_ID@"
application/signature=""
application/short_version="@VERSION@"
application/version="1"
application/min_ios_version="17.0"
application/export_project_only=true
application/targeted_device_family=2
application/delete_old_export_files_unconditionally=true
entitlements/increased_memory_limit=true
icons/icon_1024x1024="res://icon.png"
user_data/accessible_from_files_app=true
user_data/accessible_from_itunes_sharing=true
dotnet/include_scripts_content=false
dotnet/include_debug_symbols=false
dotnet/embed_build_outputs=false
